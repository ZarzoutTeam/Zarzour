{
  "info": {
    "name": "Zarzour Sport - Regression (Epic 5-9 cleanup)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Live regression flows run before Epic 10. Covers pricing (5 steps), guest vs authenticated order creation, cancellation paths, out-of-stock rejection, and Arabic validation messages. DB-only side effects (stock_movements rows, notifications table) are verified separately via tinker, not through this collection."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "main_product_id", "value": "" },
    { "key": "gift_product_id", "value": "" },
    { "key": "province_id", "value": "" },
    { "key": "low_stock_product_id", "value": "" },
    { "key": "coupon_code", "value": "REGRESS25" },
    { "key": "registered_user_phone", "value": "" },
    { "key": "registered_user_password", "value": "" },
    { "key": "auth_token", "value": "" },
    { "key": "guest_order_id", "value": "" },
    { "key": "registered_order_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/health"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('status 200', () => pm.response.to.have.status(200));"
        ]}
      }]
    },
    {
      "name": "2. Guest order - full 5-step pricing (discount+coupon+offer+gift+shipping)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"زبون ضيف\",\n  \"phone_number\": \"0911111111\",\n  \"province_id\": {{province_id}},\n  \"shipping_address\": \"دمشق - المزة\",\n  \"payment_method\": \"cod\",\n  \"coupon_code\": \"{{coupon_code}}\",\n  \"lines\": [ { \"product_id\": {{main_product_id}}, \"quantity\": 1 } ]\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('201 created', () => pm.response.to.have.status(201));",
          "const guestOrderData = pm.response.json().data;",
          "pm.test('subtotal is 100 (raw price)', () => pm.expect(guestOrderData.subtotal).to.eql(100));",
          "pm.test('discount_amount reflects direct+coupon+offer stacking (100-62.5=37.5)', () => pm.expect(guestOrderData.discount_amount).to.eql(37.5));",
          "pm.test('shipping_fee applied from province', () => pm.expect(guestOrderData.shipping_fee).to.eql(15000));",
          "pm.test('total = discounted subtotal + shipping (62.5+15000)', () => pm.expect(guestOrderData.total).to.eql(15062.5));",
          "pm.test('gift item present', () => {",
          "  const gift = guestOrderData.items.find(i => i.is_gift === true);",
          "  pm.expect(gift, 'gift item').to.not.be.undefined;",
          "  pm.expect(gift.product_id).to.eql(Number(pm.variables.get('gift_product_id')));",
          "});",
          "pm.collectionVariables.set('guest_order_id', guestOrderData.order_id);"
        ]}
      }]
    },
    {
      "name": "3. Login registered user (Sanctum)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{registered_user_phone}}\",\n  \"password\": \"{{registered_user_password}}\"\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 ok', () => pm.response.to.have.status(200));",
          "const loginData = pm.response.json().data;",
          "pm.collectionVariables.set('auth_token', loginData.token);"
        ]}
      }]
    },
    {
      "name": "4. Registered user order (no coupon) - user_id linkage",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "url": "{{base_url}}/api/v1/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"عميل مسجل اختبار\",\n  \"phone_number\": \"{{registered_user_phone}}\",\n  \"province_id\": {{province_id}},\n  \"shipping_address\": \"حلب\",\n  \"payment_method\": \"cod\",\n  \"lines\": [ { \"product_id\": {{main_product_id}}, \"quantity\": 1 } ]\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('201 created', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('registered_order_id', pm.response.json().data.order_id);"
        ]}
      }]
    },
    {
      "name": "5. GET my orders - confirms order.user_id was set",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "url": "{{base_url}}/api/v1/me/orders"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 ok', () => pm.response.to.have.status(200));",
          "const items = pm.response.json().data.items;",
          "const orderId = pm.collectionVariables.get('registered_order_id');",
          "pm.test('created order appears in my-orders (proves user_id linkage)', () => {",
          "  pm.expect(items.some(o => String(o.id) === String(orderId))).to.be.true;",
          "});"
        ]}
      }]
    },
    {
      "name": "6. Cancel pending order (own order) - release only",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "url": "{{base_url}}/api/v1/me/orders/{{registered_order_id}}/cancel"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('200 ok', () => pm.response.to.have.status(200));",
          "pm.test('status is cancelled', () => pm.expect(pm.response.json().data.status).to.eql('cancelled'));"
        ]}
      }]
    },
    {
      "name": "7. Order exceeding available quantity is rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/v1/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"زبون كمية زائدة\",\n  \"phone_number\": \"0922222222\",\n  \"province_id\": {{province_id}},\n  \"shipping_address\": \"دمشق\",\n  \"payment_method\": \"cod\",\n  \"lines\": [ { \"product_id\": {{low_stock_product_id}}, \"quantity\": 999 } ]\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('rejected (4xx/5xx, not 201)', () => pm.expect(pm.response.code).to.not.eql(201));"
        ]}
      }]
    },
    {
      "name": "8. Arabic validation - missing required fields",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/v1/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lines\": [ { \"product_id\": {{main_product_id}}, \"quantity\": 1 } ]\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('422 unprocessable', () => pm.response.to.have.status(422));",
          "const errors = pm.response.json().errors;",
          "pm.test('payment_method error is fully Arabic (no literal field name leaking)', () => {",
          "  pm.expect(errors.payment_method[0]).to.not.include('payment_method');",
          "  pm.expect(errors.payment_method[0]).to.include('طريقة الدفع');",
          "});",
          "pm.test('shipping_address error is fully Arabic', () => {",
          "  pm.expect(errors.shipping_address[0]).to.not.include('shipping_address');",
          "  pm.expect(errors.shipping_address[0]).to.include('عنوان الشحن');",
          "});",
          "pm.test('province_id error is fully Arabic', () => {",
          "  pm.expect(errors.province_id[0]).to.not.include('province_id');",
          "  pm.expect(errors.province_id[0]).to.include('المحافظة');",
          "});"
        ]}
      }]
    },
    {
      "name": "9. Arabic validation - invalid payment_method value",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/v1/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"زبون\",\n  \"phone_number\": \"0933333333\",\n  \"province_id\": {{province_id}},\n  \"shipping_address\": \"حمص\",\n  \"payment_method\": \"bitcoin\",\n  \"lines\": [ { \"product_id\": {{main_product_id}}, \"quantity\": 1 } ]\n}"
        }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('422 unprocessable', () => pm.response.to.have.status(422));",
          "const errors = pm.response.json().errors;",
          "pm.test('invalid payment_method value error is fully Arabic', () => {",
          "  pm.expect(errors.payment_method[0]).to.not.include('payment_method');",
          "  pm.expect(errors.payment_method[0]).to.include('طريقة الدفع');",
          "});"
        ]}
      }]
    }
  ]
}
